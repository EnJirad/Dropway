# ==============================================================================
# DropWay - Neon Database Configuration (Serverless PostgreSQL)
# นำ Connection string มาจาก Neon Console (https://console.neon.tech)
# เมนู Dashboard -> Connection Details
# ==============================================================================
DATABASE_URL=postgresql://neondb_owner:your-password-here@ep-your-endpoint-id.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ==============================================================================
# คีย์สำหรับเข้ารหัส API key ของผู้ใช้ก่อนเก็บลงฐานข้อมูล (AES-256-GCM)
# สร้างด้วย: openssl rand -base64 32
# ถ้าไม่ตั้งค่านี้ ระบบจะไม่ยอมบันทึก key ลงฐานข้อมูล
# ==============================================================================
AI_KEYS_SECRET=
