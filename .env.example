# ==============================================================================
# Neon Database Configuration (Serverless PostgreSQL - แนะนำ)
# นำ Connection string มาจาก Neon Console (https://console.neon.tech) -> Dashboard -> Connection Details
# ==============================================================================
DATABASE_URL=postgresql://neondb_owner:your-password-here@ep-your-endpoint-id.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ==============================================================================
# DropWay - ตัวอย่างการตั้งค่า Environment Variables สำหรับเชื่อมต่อ Supabase
# ==============================================================================
# วิธีนำไปใช้:
# 1. คัดลอกไฟล์นี้แล้วเปลี่ยนชื่อเป็น .env.local
#    (คำสั่ง: cp .env.example .env.local)
# 2. เข้า Supabase Dashboard: https://supabase.com/dashboard
# 3. เลือกโปรเจกต์ของคุณ -> เข้าไปที่ Project Settings (ไอคอนฟันเฟืองล่างซ้าย) -> เมนู "API"
# 4. นำค่า "Project URL" และ "anon public key" มาแทนที่ค่าด้านล่างนี้
# 5. รันทดสอบการเชื่อมต่อด้วยคำสั่ง: npm run test:supabase
# ==============================================================================

# URL ของ Supabase Project เช่น https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anon Public Key (หรือในบางระบบอาจเรียกว่า Publishable Key เป็นคีย์ public ที่ปลอดภัยสำหรับใช้งานบน client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
# หรือสามารถใช้ชื่อนี้แทนได้:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
